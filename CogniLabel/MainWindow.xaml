<Window x:Class="CogniLabel.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CogniLabel.Presentation.ViewModels"
        xmlns:conv="clr-namespace:CogniLabel.Presentation.Converters"
        mc:Ignorable="d"
        Title="CogniLabel" Height="900" Width="1300"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <conv:EnumToStringConverter x:Key="StageToText" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Config Panel -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="Excel" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding ExcelPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                    <TextBlock Text="图片目录" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding ImageFolderPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="模板" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding TemplatePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="{x:Static vm:UiStrings.BrowseExcel}"
                            Command="{Binding BrowseExcelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0,0,8,0"/>
                    <Button Content="{x:Static vm:UiStrings.BrowseImageFolder}"
                            Command="{Binding BrowseImageFolderCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0,0,8,0"/>
                    <Button Content="{x:Static vm:UiStrings.BrowseTemplate}"
                            Command="{Binding BrowseTemplateCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Width="120"/>
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Content="{x:Static vm:UiStrings.NewTemplate}"
                                Command="{Binding CreateTemplateCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,0"/>
                        <Button Content="{x:Static vm:UiStrings.EditTemplate}"
                                Command="{Binding EditTemplateCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="100"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{x:Static vm:UiStrings.StartAudit}"
                                Command="{Binding RunAuditCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="140" Margin="0,0,8,0"/>
                        <Button Content="{x:Static vm:UiStrings.Cancel}"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DangerButtonStyle}" Width="100"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Status Panel -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding CurrentStage, Converter={StaticResource StageToText}}" Style="{StaticResource TitleStyle}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CurrentMessage}" Style="{StaticResource SubtleTextStyle}" Margin="0,2,0,8"/>
                    <ProgressBar Minimum="0"
                                 Maximum="{Binding ProgressTotal, Mode=OneWay}"
                                 Value="{Binding ProgressCurrent, Mode=OneWay}"
                                 Height="14"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Total, StringFormat=总数：{0}}" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="{Binding Pass, StringFormat=PASS：{0}}" Foreground="{StaticResource SuccessBrush}" Style="{StaticResource SubtleTextStyle}"/>
                    <TextBlock Text="{Binding Fail, StringFormat=FAIL：{0}}" Foreground="{StaticResource ErrorBrush}" Style="{StaticResource SubtleTextStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Result Panel -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      EnableRowVirtualization="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      RowHeight="32"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Style="{StaticResource DataGridStyle}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPass}" Value="False">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Setter Property="Foreground" Value="#991B1B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="图片名" Binding="{Binding ImageName}" Width="1.5*"/>
                    <DataGridTextColumn Header="SN" Binding="{Binding SN}" Width="200"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                    <DataGridTextColumn Header="异常类型" Binding="{Binding ErrorTypeText}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Action Panel (Sticky) -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static vm:UiStrings.Export}"
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Width="140"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

