<Window x:Class="CogniLabel.Presentation.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CogniLabel.Presentation.ViewModels"
        xmlns:conv="clr-namespace:CogniLabel.Presentation.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="520" Width="880"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:RoiCanvasConverter x:Key="RoiCanvas" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding EditorMessage}"
                   Foreground="{StaticResource ErrorBrush}"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,12,0">
            <DataGrid x:Name="FieldsGrid"
                      ItemsSource="{Binding Fields}"
                      SelectedItem="{Binding SelectedField}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static vm:UiStrings.FieldNameColumn}"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120"/>
                    <DataGridCheckBoxColumn Header="{x:Static vm:UiStrings.IsSnColumn}"
                                            Binding="{Binding IsSn}"
                                            Width="72"/>
                    <DataGridTextColumn Header="{x:Static vm:UiStrings.RoiXColumn}"
                                        Binding="{Binding EditableRoiX, UpdateSourceTrigger=LostFocus}"
                                        Width="70"/>
                    <DataGridTextColumn Header="{x:Static vm:UiStrings.RoiYColumn}"
                                        Binding="{Binding EditableRoiY, UpdateSourceTrigger=LostFocus}"
                                        Width="70"/>
                    <DataGridTextColumn Header="{x:Static vm:UiStrings.RoiWColumn}"
                                        Binding="{Binding EditableRoiW, UpdateSourceTrigger=LostFocus}"
                                        Width="70"/>
                    <DataGridTextColumn Header="{x:Static vm:UiStrings.RoiHColumn}"
                                        Binding="{Binding EditableRoiH, UpdateSourceTrigger=LostFocus}"
                                        Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="LoadImageButton"
                            Content="{x:Static vm:UiStrings.LoadSampleImage}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="140"
                            Click="OnLoadSampleImageClick"/>
                </StackPanel>

                <Canvas x:Name="ImageHost"
                        Grid.Row="1"
                        Background="#FFF9FAFB"
                        ClipToBounds="True"
                        SizeChanged="OnImageHostSizeChanged">
                    <Image x:Name="SampleImage"
                           Stretch="Fill"
                           Canvas.Left="0"
                           Canvas.Top="0"/>

                    <!-- overlay aligned to image display rect; set in code-behind -->
                    <Canvas x:Name="Overlay"
                            Background="Transparent"
                            Canvas.Left="0"
                            Canvas.Top="0"
                            SizeChanged="OnOverlaySizeChanged"
                            MouseLeftButtonDown="OnOverlayMouseLeftButtonDown"
                            MouseMove="OnOverlayMouseMove"
                            MouseLeftButtonUp="OnOverlayMouseLeftButtonUp">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <!--
                                IMPORTANT:
                                ItemsControl 的 Canvas 布局读取的是“ItemContainer(ContentPresenter)”上的 Canvas.Left/Top，
                                不是 DataTemplate 内部元素的 Canvas.Left/Top。
                                所以必须把定位绑定放到 ItemContainerStyle，否则会出现“尺寸正确但总在(0,0)”的现象。
                            -->
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource RoiCanvas}">
                                                <Binding Path="RoiX"/>
                                                <Binding ElementName="Overlay" Path="ActualWidth"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Canvas.Top">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource RoiCanvas}">
                                                <Binding Path="RoiY"/>
                                                <Binding ElementName="Overlay" Path="ActualHeight"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TemplateEditorFieldRowViewModel}">
                                    <Canvas MouseLeftButtonDown="OnRoiMouseLeftButtonDown">
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RoiW}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RoiH}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>

                                        <Rectangle Fill="#2D3B82F6">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Stroke" Value="#2563EB" />
                                                    <Setter Property="StrokeThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Stroke" Value="#DC2626" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                            <Rectangle.Width>
                                                <MultiBinding Converter="{StaticResource RoiCanvas}">
                                                    <Binding Path="RoiW"/>
                                                    <Binding ElementName="Overlay" Path="ActualWidth"/>
                                                </MultiBinding>
                                            </Rectangle.Width>
                                            <Rectangle.Height>
                                                <MultiBinding Converter="{StaticResource RoiCanvas}">
                                                    <Binding Path="RoiH"/>
                                                    <Binding ElementName="Overlay" Path="ActualHeight"/>
                                                </MultiBinding>
                                            </Rectangle.Height>
                                        </Rectangle>

                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#111827"
                                                   Background="#CCFFFFFF"
                                                   Padding="4,2"
                                                   FontSize="11"/>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Canvas>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,12">
            <Button Content="{x:Static vm:UiStrings.AddTemplateField}"
                    Command="{Binding AddFieldCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0,0,8,0"/>
            <Button Content="{x:Static vm:UiStrings.RemoveTemplateField}"
                    Command="{Binding RemoveFieldCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Width="120"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static vm:UiStrings.SaveTemplate}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Width="120" Margin="0,0,8,0"/>
            <Button Content="{x:Static vm:UiStrings.Cancel}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
